<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_Overdue__c</fullName>
    <description>True when the Due Date is in the past and the follow-up has not been marked Completed.</description>
    <formula>AND(
    NOT(ISBLANK(Due_Date__c)),
    Due_Date__c &lt; TODAY(),
    NOT(ISPICKVAL(Status__c, &quot;Completed&quot;))
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is Overdue</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
