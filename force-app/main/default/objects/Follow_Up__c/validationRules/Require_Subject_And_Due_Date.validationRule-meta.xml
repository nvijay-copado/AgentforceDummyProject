<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Subject_And_Due_Date</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    ISBLANK(Subject__c),
    ISBLANK(TEXT(Due_Date__c))
)</errorConditionFormula>
    <errorMessage>Subject and Due Date are required to save a Follow-Up.</errorMessage>
</ValidationRule>
